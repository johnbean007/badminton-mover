# Copy to .env.local and fill in from Supabase: Project Settings → API Keys (and Data API for the URL).
# .env.local is git-ignored. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Lets the admin invite and remove members.
SUPABASE_SECRET_KEY=sb_secret_...
# Where sign-in links point when the request has no Origin header (production URL once deployed).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare R2 (video storage). Server-only. From R2 → Manage API tokens; bucket is private.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=badminton-mover-videos
# Modal worker trigger. URL from `modal deploy`; the token must match the Modal secret
# badminton-mover-worker-token. Server-only.
WORKER_URL=https://<workspace>--badminton-mover-trigger.modal.run
WORKER_TOKEN=
